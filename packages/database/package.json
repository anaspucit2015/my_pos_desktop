{
  "name": "@my-pos/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./db": "./src/db.ts",
    "./repositories/*": "./src/repositories/*.ts"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "migrate": "tsx src/migrations/migrate.ts",
    "seed": "tsx src/seeds/dev.seed.ts"
  },
  "dependencies": {
    "@my-pos/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "drizzle-orm": "^0.30.10"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/jest": "^29.5.12",
    "drizzle-kit": "^0.21.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "tsx": "^4.9.3",
    "typescript": "^5.4.5"
  }
}
