{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@my-pos/shared/*": ["./packages/shared/src/*"],
      "@my-pos/database/*": ["./packages/database/src/*"],
      "@my-pos/core/*": ["./packages/core/src/*"],
      "@my-pos/ipc/*": ["./packages/ipc/src/*"],
      "@my-pos/hardware/*": ["./packages/hardware/src/*"]
    }
  }
}
